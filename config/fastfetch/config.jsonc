// fastfetch (https://github.com/fastfetch-cli/fastfetch) greets new
// interactive shells with this summary: home/.zshrc and
// config/powershell/profile.ps1 run it with --config pointing here, skip it
// inside tmux and in non-interactive shells, and DOTFILES_FASTFETCH=0 turns
// it off on a machine. The colors are Catppuccin Macchiato hex values, which
// fastfetch 2.42+ accepts directly; scripts/theme.sh rewrites them. The
// modules avoid the slow detectors (packages, public and local IP, GPU).
// Comments are full lines only, so scripts/test.sh can validate the JSON.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 1, "right": 3 },
    "color": { "1": "#8aadf4", "2": "#b7bdf8" }
  },
  "display": {
    "color": {
      "keys": "#8aadf4",
      "title": "#c6a0f6",
      "separator": "#6e738d",
      "output": "#cad3f5"
    }
  },
  "modules": [
    { "type": "title", "color": { "user": "#f5bde6", "at": "#8087a2", "host": "#b7bdf8" } },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
